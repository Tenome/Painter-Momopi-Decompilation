# The ROM and anything extracted from it (supply your own copy in orig/)
orig/*
!orig/README.md
*.gb
*.gbc
*.sav

# Data extracted from the ROM by tools/gb_dis.py --write (edit these to mod the game)
assets/

# Build outputs
build/
*.o
*.map
*.sym

# Ghidra projects and exports (analysis output of the original binary)
*.gpr
*.rep/
ghidra/

# Python
__pycache__/
*.pyc

# Scratch
scratch/
re_loop_sessions/

# Texture sheets made from the game graphics (tools/export_textures.py) and local editor settings
textures/
packs/**/textures*/
tools/.level_editor.json

# the game's own levels converted to a pack (made from the ROM data by tools/levelpack.py original)
packs/original.pmpack
screenshots/
painter_momopie.sav
*.sav
dist/
tools/.enemy_icons/
textures_example/
packs/community/
submissions/
